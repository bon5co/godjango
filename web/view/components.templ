package view

// Layout owns the document head. Applications cannot reach into it, and the
// default Content-Security-Policy is default-src 'self', so an inline <style>
// or <script> in an application component is silently dropped by the browser.
// Stylesheets and scripts are therefore the supported way for an application to
// ship its own CSS and JavaScript: same-origin URLs it serves itself, which the
// policy already allows. Head metadata arrives the same way -- as data in
// Document, resolved by Render -- so every value is escaped on the way out and
// no application string reaches the head as markup.
templ Layout(document Document, content templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ document.CSRFToken }/>
			<title>{ document.Title }</title>
			for _, tag := range document.MetaTags {
				if tag.Property != "" {
					<meta property={ tag.Property } content={ tag.Content }/>
				} else {
					<meta name={ tag.Name } content={ tag.Content }/>
				}
			}
			for _, link := range document.Links {
				if link.Type != "" {
					<link rel={ link.Rel } type={ link.Type } href={ link.Href }/>
				} else {
					<link rel={ link.Rel } href={ link.Href }/>
				}
			}
			<link rel="stylesheet" href="/static/godjango/godjango.css"/>
			for _, stylesheet := range document.Stylesheets {
				<link rel="stylesheet" href={ stylesheet }/>
			}
			<script defer src="/static/godjango/htmx-2.0.9.min.js"></script>
			<script defer src="/static/godjango/alpine-3.15.12.min.js"></script>
			<script defer src="/static/godjango/godjango.js"></script>
			for _, script := range document.Scripts {
				<script defer src={ script }></script>
			}
		</head>
		<body>
			<main id="main" tabindex="-1">
				@content
			</main>
		</body>
	</html>
}

templ Stack(components ...templ.Component) {
	<div class="gd-stack">
		for _, component := range components {
			@component
		}
	</div>
}

templ Page(title string, components ...templ.Component) {
	<section class="gd-page">
		<h1>{ title }</h1>
		@Stack(components...)
	</section>
}

templ Paragraph(message string) {
	<p>{ message }</p>
}

templ Link(href string, label string) {
	<a href={ templ.SafeURL(href) }>{ label }</a>
}

templ Form(data FormData) {
	<form
		class="gd-form"
		action={ data.Action }
		method={ data.method() }
		hx-post={ data.Action }
		hx-target="this"
		hx-swap="outerHTML focus-scroll:true"
	>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		if len(data.ErrorSummary) > 0 {
			<div class="gd-errors" role="alert" tabindex="-1" autofocus?={ !hasFieldErrors(data.Fields) }>
				<p>Please correct the errors below.</p>
				<ul>
					for _, message := range data.ErrorSummary {
						<li>{ message }</li>
					}
				</ul>
			</div>
		}
		for index, field := range data.Fields {
			if field.inputType() == "hidden" {
				<input
					name={ field.Name }
					type="hidden"
					value={ field.Value }
				/>
			} else {
				<div class="gd-field">
					<label for={ field.Name }>{ field.Label }</label>
					<input
						id={ field.Name }
						name={ field.Name }
						type={ field.inputType() }
						value={ field.Value }
						autocomplete={ field.Autocomplete }
						if len(field.Errors) > 0 {
							aria-invalid="true"
							aria-describedby={ field.Name + "-error" }
						}
						autofocus?={ len(field.Errors) > 0 && firstInvalidField(data.Fields) == index }
					/>
					if len(field.Errors) > 0 {
						<ul class="gd-field-errors" id={ field.Name + "-error" }>
							for _, message := range field.Errors {
								<li>{ message }</li>
							}
						</ul>
					}
				</div>
			}
		}
		<button type="submit">{ data.SubmitLabel }</button>
	</form>
}

templ FlashMessages(messages []Flash) {
	<div class="gd-flashes" aria-live="polite">
		for _, message := range messages {
			if message.Level == FlashError {
				<p class="gd-flash gd-flash-error" role="alert">{ message.Message }</p>
			} else {
				<p class="gd-flash gd-flash-success" role="status">{ message.Message }</p>
			}
		}
	</div>
}

templ Pagination(data PaginationData) {
	if data.Total > 1 && data.URL != nil {
		<nav class="gd-pagination" aria-label="Pagination" hx-boost="true">
			for _, page := range pages(data.Total) {
				if page == data.Current {
					<a href={ templ.SafeURL(data.URL(page)) } aria-current="page">{ page }</a>
				} else {
					<a href={ templ.SafeURL(data.URL(page)) }>{ page }</a>
				}
			}
		</nav>
	}
}
